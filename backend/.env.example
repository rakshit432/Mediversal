# Database
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/mediversal

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Credentials
ADMIN_EMAIL=admin@mediversal.com
ADMIN_PASSWORD=

# Security
JWT_SECRET=
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini AI (Triage & RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=4000